[Unit]
Description=Enterprise SMS Platform latest production backup integrity and RPO check
RequiresMountsFor=/var/lib/sms-platform/runtime
StartLimitIntervalSec=20min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sms-platform/lifecycle.env
LoadCredential=sms-host-mountinfo:/proc/1/mountinfo
Environment=SMS_STORAGE_HOST_MOUNTINFO_CREDENTIAL=1
ExecStartPre=/usr/local/sbin/sms-storage-preflight --mode observe
ExecStart=/usr/local/sbin/sms-compose host-lifecycle backup-status
Restart=on-failure
RestartSec=5min
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
DevicePolicy=closed
DeviceAllow=block-sd r
DeviceAllow=block-device-mapper r
ReadWritePaths=/var/lib/sms-platform/runtime/backups
ReadOnlyPaths=/opt/sms-platform /etc/sms-platform /dev/disk/by-uuid /dev/disk/by-id
StandardOutput=journal
StandardError=journal
