[Unit]
Description=Enterprise SMS Platform latest production backup integrity and RPO check
RequiresMountsFor=/var/lib/sms-platform/runtime
StartLimitIntervalSec=20min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sms-platform/lifecycle.env
ExecStartPre=/usr/local/sbin/sms-storage-preflight --mode observe
ExecStartPre=/usr/bin/python3 /opt/sms-platform/deploy/scripts/host_python_preflight.py lifecycle
ExecStart=/usr/bin/python3 /opt/sms-platform/deploy/scripts/lifecycle_manager.py backup-status
Restart=on-failure
RestartSec=5min
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
DevicePolicy=closed
ReadWritePaths=/var/lib/sms-platform/runtime/backups
ReadOnlyPaths=/opt/sms-platform /etc/sms-platform /dev/disk/by-uuid
StandardOutput=journal
StandardError=journal
