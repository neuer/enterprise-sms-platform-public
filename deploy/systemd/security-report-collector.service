[Unit]
Description=SMS Platform redacted security daily evidence collector
Requisite=sms-platform.service
After=sms-platform.service
StartLimitIntervalSec=20min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sms-platform/compose.env
ExecStart=/usr/local/sbin/sms-compose security-report
Restart=on-failure
RestartSec=5min
TimeoutStartSec=10min
MemoryMax=384M
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID
ReadOnlyPaths=-/var/log/auth.log -/var/log/secure -/var/log/fail2ban.log -/var/log/nginx/access.log
ReadOnlyPaths=/opt/sms-platform
ReadOnlyPaths=/var/lib/sms-platform/security-report/nginx
ReadWritePaths=/var/lib/sms-platform/security-report/control/incoming
StandardOutput=journal
StandardError=journal
