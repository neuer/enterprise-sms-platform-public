[Unit]
Description=Enterprise SMS Platform controlled partition maintenance
Requires=docker.service
Requisite=sms-platform.service
After=docker.service sms-platform.service
StartLimitIntervalSec=20min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sms-platform/compose.env
LoadCredential=sms-host-mountinfo:/proc/1/mountinfo
Environment=SMS_STORAGE_HOST_MOUNTINFO_CREDENTIAL=1
ExecStart=/usr/local/sbin/sms-compose partition-maintenance
Restart=on-failure
RestartSec=5min
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
DevicePolicy=closed
DeviceAllow=block-sd r
DeviceAllow=block-device-mapper r
ReadWritePaths=/run/sms-platform /run/docker.sock
ReadOnlyPaths=/opt/sms-platform /etc/sms-platform /dev/disk/by-uuid /dev/disk/by-id
StandardOutput=journal
StandardError=journal
