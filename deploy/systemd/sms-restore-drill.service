[Unit]
Description=Enterprise SMS Platform preproduction isolated restore drill
ConditionPathExists=/etc/sms-platform/preproduction-restore-host
Requires=docker.service
Requisite=sms-platform.service
After=docker.service sms-platform.service sms-backup.service
RequiresMountsFor=/var/lib/sms-platform/runtime
StartLimitIntervalSec=20min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sms-platform/lifecycle.env
ExecStartPre=/usr/local/sbin/sms-storage-preflight --mode startup
ExecStartPre=/usr/bin/python3 /opt/sms-platform/deploy/scripts/host_python_preflight.py lifecycle
ExecStart=/usr/bin/python3 /opt/sms-platform/deploy/scripts/lifecycle_manager.py drill
Restart=on-failure
RestartSec=5min
# Only an isolated preproduction restore host may carry the marker above.
# The 12h limit is an isolated database restore engineering deadline, not business RTO evidence.
# The outer guard leaves one hour for final verification and bounded cleanup.
TimeoutStartSec=13h
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=block-sd r
DeviceAllow=block-device-mapper r
ReadWritePaths=/var/lib/sms-platform/runtime/backups /run/docker.sock
ReadOnlyPaths=/opt/sms-platform /etc/sms-platform /dev/disk/by-uuid /dev/disk/by-id
StandardOutput=journal
StandardError=journal
