  if [[ "$SECRETS_MODE" == production ]]; then
    echo "sms-compose: vendor control agent is forbidden in production mode" >&2
    return 1
  fi
  if [[ ! -f /etc/sms-platform/test-host &&
        "$ROOT" == /opt/sms-platform && "$PRODUCTION_CONTROL_SMOKE" != 1 ]]; then
    echo "sms-compose: vendor control agent requires the test-host marker" >&2
    return 1
  fi
}

run_locked_operation() {
  local operation="$1"
  local lock_fd="${SMS_LIFECYCLE_LOCK_FD:-}"
  shift
  if [[ "${SMS_LIFECYCLE_LOCKED:-}" != 1 || ! "$lock_fd" =~ ^[0-9]+$ ]]; then
    echo "sms-compose: private locked action is unavailable" >&2
    return 2
  fi
  if ! "${LOCK_PYTHON[@]}" "$LOCK_RUNNER" verify-held \
    --runtime-root "$RUNTIME_ROOT" \
    --lock-fd "$lock_fd"; then
    echo "sms-compose: private locked action has no verified lock" >&2
    return 2
  fi
  unset SMS_LIFECYCLE_LOCKED
  unset SMS_LIFECYCLE_LOCK_FD
  case "$operation" in
    up)
      if [[ "$SECRETS_MODE" == production ]]; then
        validate_production_up_args "$@"
        validate_production_launch
      fi
      start_stack "$@"
      ;;
    down)
      validate_down_args "$@"
      if [[ "$SECRETS_MODE" == production ]]; then
        configure_compose_topology
      fi
      stop_stack "$@"
      ;;
    rotate)
      [[ $# -eq 0 ]] || return 2
      if [[ "$SECRETS_MODE" == production ]]; then
        validate_production_launch
      fi
      rotate_backend
      ;;
    migrate)
      [[ $# -eq 0 ]] || return 2
      if [[ "$SECRETS_MODE" == production ]]; then
        validate_production_launch
      fi
      run_migrate
      ;;
    partition-maintenance)
      [[ $# -eq 0 || ($# -eq 1 && "$1" == --dry-run) ]] || return 2
      if [[ "$SECRETS_MODE" == production ]]; then
        validate_production_launch
      fi
      run_partition_maintenance "$@"
      ;;
    init-admin)
      validate_init_admin_args "$@"
      run_init_admin
      ;;
    continuity)
      SMS_LIFECYCLE_LOCKED=1 SMS_LIFECYCLE_LOCK_FD="$lock_fd" \
        run_locked_continuity "$lock_fd" "$@"
      ;;
    release)
      case "${1:-}" in
        __host-control)
          shift
          SMS_LIFECYCLE_LOCKED=1 SMS_LIFECYCLE_LOCK_FD="$lock_fd" \
            run_locked_host_control "$@"
          ;;
        __host-lifecycle)
          shift
          run_locked_host_lifecycle "$@"
          ;;
        __security-report)
          shift
          run_locked_security_report "$@"
          ;;
        *)
          run_locked_release "$@"
          ;;
      esac
      ;;
    vendor-test)
      SMS_LIFECYCLE_LOCKED=1 SMS_LIFECYCLE_LOCK_FD="$lock_fd" \
        run_locked_vendor_test "$@"
      ;;
    test-update)
      SMS_LIFECYCLE_LOCKED=1 SMS_LIFECYCLE_LOCK_FD="$lock_fd" \
        run_locked_test_update "$@"
      ;;
    *)
      echo "sms-compose: private locked operation is invalid" >&2
      return 2
      ;;
  esac
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

if [[ "$1" == -* ]]; then
  echo "sms-compose: the action must be the first argument" >&2
  exit 2
fi

ACTION="$1"
shift

# The stable production launcher intentionally hands every public invocation a
# verified inherited lock.  That carrier must never turn the private recursive
# helper action into a caller-facing dispatcher bypass.  Real production uses
# the public action directly; only development/test bootstrap recursion needs
# __locked.
if [[ "$ACTION" == __locked && "$SECRETS_MODE" == production &&
      "$PRODUCTION_CONTROL_SMOKE" != 1 && "$HOST_BOOTSTRAP" != 1 ]]; then
  echo "sms-compose: direct private locked entry is forbidden in production" >&2
  exit 2
fi

if [[ "$HOST_BOOTSTRAP" == 1 &&
      "$ACTION" != test-update && "$ACTION" != __locked ]]; then
  echo "sms-compose: bootstrap wrapper only permits test-update" >&2
  exit 2
fi

case "$SECRETS_MODE" in
  production | development) ;;
  *)
    echo "sms-compose: invalid secrets mode" >&2
    exit 2
    ;;
esac

validate_control_entry
validate_control_state_binding "$ACTION" "$@"
configure_internal_compose_env

case "$ACTION" in
  up | down | rotate | run | partition-maintenance | init-admin | continuity | release | vendor-test | test-update | __locked)
    configure_release_root
    ;;
esac

if [[ "$ACTION" == __locked ]]; then
  if [[ $# -lt 1 ]]; then
    exit 2
  fi
  locked_operation="$1"
  shift
  run_locked_operation "$locked_operation" "$@"
  exit
fi

case "$ACTION" in
  up)
    if [[ "$SECRETS_MODE" == production ]]; then
      validate_production_up_args "$@"
      validate_production_launch release
    fi
    run_with_lifecycle_lock up "$@"
    ;;
  down)
    validate_down_args "$@"
    if [[ "$SECRETS_MODE" == production ]]; then
      configure_compose_topology
    fi
    run_with_lifecycle_lock down "$@"
    ;;
  rotate)
    if [[ $# -ne 1 || "$1" != "backend" ]]; then
      usage
      exit 2
    fi
    if [[ "$SECRETS_MODE" == production ]]; then
      validate_production_launch release
    fi
    run_with_lifecycle_lock rotate
    ;;
  run)
    if [[ $# -ne 2 || "$1" != --rm || "$2" != migrate ]]; then
      usage
      exit 2
    fi
    if [[ "$SECRETS_MODE" == production ]]; then
      validate_production_launch release
    fi
    run_with_lifecycle_lock migrate
    ;;
  partition-maintenance)
    if [[ $# -gt 1 || ($# -eq 1 && "$1" != --dry-run) ]]; then
      usage
      exit 2
    fi
    if [[ "$SECRETS_MODE" == production ]]; then
      validate_production_launch release
    fi
    run_with_lifecycle_lock partition-maintenance "$@"
    ;;
  init-admin)
    validate_init_admin_args "$@"
    if [[ "$SECRETS_MODE" == production ]]; then
      validate_production_launch release
      run_with_lifecycle_lock init-admin "$@"
    else
      run_init_admin
    fi
    ;;
  continuity)
    if dispatch_continuity "$@"; then
      :
    else
      continuity_status=$?
      usage
      exit "$continuity_status"
    fi
    ;;
  release)
    if dispatch_release "$@"; then
      :
    else
      release_status=$?
      usage
      exit "$release_status"
    fi
    ;;
  vendor-test)
    if dispatch_vendor_test "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  test-update)
    if dispatch_test_update "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  secure-access)
    if dispatch_secure_access "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  cloudflare-tunnel)
    if dispatch_cloudflare_tunnel "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  host-control)
    if dispatch_host_control "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  host-lifecycle)
    if dispatch_host_lifecycle "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  security-report)
    if dispatch_security_report "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  vendor-agent-preflight)
    if dispatch_vendor_agent_preflight "$@"; then
      :
    else
      control_status=$?
      usage
      exit "$control_status"
    fi
    ;;
  config | ps | logs)
    if [[ "$SECRETS_MODE" == production ]]; then
      if [[ "$ACTION" == config && $# -eq 1 && "$1" == --quiet ]]; then
        :
      elif [[ $# -ne 0 ]]; then
        echo "sms-compose: production diagnostics do not accept arguments" >&2
        exit 2
      fi
      configure_compose_topology
    fi
    "${COMPOSE[@]}" "$ACTION" "$@"
    ;;
  exec)
    if [[ "$SECRETS_MODE" == production ]]; then
      echo "sms-compose: generic exec is forbidden in production mode" >&2
      exit 2
    fi
    "${COMPOSE[@]}" exec "$@"
    ;;
  cp)
    if [[ "$SECRETS_MODE" == production ]]; then
      usage
      exit 2
    fi
    "${COMPOSE[@]}" cp "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
