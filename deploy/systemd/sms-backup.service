[Unit]
Description=Enterprise SMS Platform encrypted backup
Requires=docker.service
Requisite=sms-platform.service
After=docker.service sms-platform.service
RequiresMountsFor=/var/lib/sms-platform/runtime
StartLimitIntervalSec=20min
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sms-platform/lifecycle.env
ExecStartPre=/usr/local/sbin/sms-storage-preflight --mode startup
ExecStartPre=/usr/bin/python3 /opt/sms-platform/deploy/scripts/host_python_preflight.py lifecycle
ExecStart=/usr/bin/python3 /opt/sms-platform/deploy/scripts/lifecycle_manager.py backup
Restart=on-failure
RestartSec=5min
# Internal deadline is 4h; the outer 5h guard leaves bounded staging cleanup margin.
TimeoutStartSec=5h
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=block-sd r
DeviceAllow=block-device-mapper r
ReadWritePaths=/var/lib/sms-platform/runtime/backups /run/docker.sock
ReadOnlyPaths=/opt/sms-platform /etc/sms-platform /dev/disk/by-uuid /dev/disk/by-id
StandardOutput=journal
StandardError=journal
