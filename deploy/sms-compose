#!/usr/bin/env bash
set -euo pipefail

WRAPPER_SOURCE="${BASH_SOURCE[0]}"
WRAPPER_SYMLINK_HOPS=0
while [[ -L "$WRAPPER_SOURCE" ]]; do
  WRAPPER_SYMLINK_HOPS=$((WRAPPER_SYMLINK_HOPS + 1))
  if ((WRAPPER_SYMLINK_HOPS > 40)); then
    echo "sms-compose: wrapper symlink chain is too deep" >&2
    exit 1
  fi
  WRAPPER_SOURCE_DIR="$(cd -- "$(dirname -- "$WRAPPER_SOURCE")" && pwd -P)"
  WRAPPER_LINK_TARGET="$(readlink "$WRAPPER_SOURCE")" || {
    echo "sms-compose: wrapper symlink target cannot be read" >&2
    exit 1
  }
  if [[ "$WRAPPER_LINK_TARGET" == /* ]]; then
    WRAPPER_SOURCE="$WRAPPER_LINK_TARGET"
  else
    WRAPPER_SOURCE="$WRAPPER_SOURCE_DIR/$WRAPPER_LINK_TARGET"
  fi
done

SCRIPT_DIR="$(cd -- "$(dirname -- "$WRAPPER_SOURCE")" && pwd -P)"
WRAPPER_PATH="$SCRIPT_DIR/${WRAPPER_SOURCE##*/}"
if [[ ! -f "$WRAPPER_PATH" ]]; then
  echo "sms-compose: wrapper target is unavailable" >&2
  exit 1
fi
RUNTIME_ROOT="${SMS_RUNTIME_ROOT:-/run/sms-platform/secrets}"
SECRETS_MODE="${SMS_SECRETS_MODE:-production}"
PRODUCTION_CONTROL_BASE="/usr/local/libexec/sms-platform/production-control"
PRODUCTION_CONTROL_SNAPSHOT=0
PRODUCTION_CONTROL_COMMIT=""
PRODUCTION_CONTROL_SMOKE="${SMS_PRODUCTION_CONTROL_SMOKE:-0}"
if [[ "$WRAPPER_PATH" =~ ^$PRODUCTION_CONTROL_BASE/versions/([0-9a-f]{40})/deploy/sms-compose$ ]]; then
  PRODUCTION_CONTROL_COMMIT="${BASH_REMATCH[1]}"
  CONTROL_ROOT="$PRODUCTION_CONTROL_BASE/versions/$PRODUCTION_CONTROL_COMMIT"
  PRODUCTION_CONTROL_SNAPSHOT=1
elif [[ "$PRODUCTION_CONTROL_SMOKE" == 1 &&
        "$WRAPPER_PATH" =~ ^(.*/production-control/versions/[0-9a-f]{40})/deploy/sms-compose$ ]]; then
  # Non-/opt smoke fixtures exercise the same root/control-root split without
  # creating host paths.  The production guard below makes this unusable on a
  # real /opt/sms-platform checkout.
  CONTROL_ROOT="${BASH_REMATCH[1]}"
  PRODUCTION_CONTROL_COMMIT="${CONTROL_ROOT##*/}"
  PRODUCTION_CONTROL_SNAPSHOT=1
else
  CONTROL_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
fi
if [[ -n "${SMS_PLATFORM_ROOT:-}" ]]; then
  ROOT="$(cd -- "$SMS_PLATFORM_ROOT" && pwd -P)"
elif [[ "$PRODUCTION_CONTROL_SNAPSHOT" == 1 ]]; then
  ROOT="/opt/sms-platform"
else
  ROOT="$CONTROL_ROOT"
fi
if [[ "$PRODUCTION_CONTROL_SNAPSHOT" == 0 && -n "${SMS_PLATFORM_ROOT:-}" &&
      ("$SECRETS_MODE" == development || "$PRODUCTION_CONTROL_SMOKE" == 1) ]]; then
  # Development and explicit non-/opt smoke fixtures may relocate the whole
  # source tree together.  Production never accepts this representation.
  CONTROL_ROOT="$ROOT"
fi

INTERNAL_COMPOSE_ENV_NAME="SMS_INTERNAL_PLATFORM_ENV_FILE"
INTERNAL_COMPOSE_ENV_WAS_SET=0
[[ ${SMS_INTERNAL_PLATFORM_ENV_FILE+x} ]] && INTERNAL_COMPOSE_ENV_WAS_SET=1
SOURCE_SECRETS_OVERRIDE_NAME="SMS_SOURCE_SECRETS_ROOT"
SOURCE_SECRETS_OVERRIDE_WAS_SET=0
[[ ${SMS_SOURCE_SECRETS_ROOT+x} ]] && SOURCE_SECRETS_OVERRIDE_WAS_SET=1
SECURITY_REPORT_PATH_OVERRIDE_WAS_SET=0
for SECURITY_REPORT_PATH_NAME in \
  SMS_SECURITY_REPORT_CONTROL_DIR \
  SMS_SECURITY_REPORT_CONFIG_DIR \
  SMS_SECURITY_REPORT_NGINX_DIR; do
  [[ ${!SECURITY_REPORT_PATH_NAME+x} ]] && SECURITY_REPORT_PATH_OVERRIDE_WAS_SET=1
done

PREPROCESSOR="$CONTROL_ROOT/deploy/scripts/prepare_runtime_secrets.py"
LOCK_RUNNER="$CONTROL_ROOT/deploy/scripts/run_with_lifecycle_lock.py"
RELEASE_MANAGER="$CONTROL_ROOT/deploy/scripts/release_manager.py"
CONTINUITY_MANAGER="$CONTROL_ROOT/deploy/scripts/continuity_manager.py"
PRODUCTION_CONTROL_MANAGER="$CONTROL_ROOT/deploy/scripts/production_control_snapshot.py"
HOST_PYTHON_PREFLIGHT="$CONTROL_ROOT/deploy/scripts/host_python_preflight.py"
LIFECYCLE_MANAGER="$CONTROL_ROOT/deploy/scripts/lifecycle_manager.py"
SECURITY_REPORT_COLLECTOR="$CONTROL_ROOT/deploy/scripts/collect_security_daily_evidence.py"
VENDOR_TEST_MANAGER="$CONTROL_ROOT/deploy/scripts/vendor_test_manager.py"
VENDOR_TEST_BOOTSTRAP="$CONTROL_ROOT/deploy/scripts/vendor_test_bootstrap.py"
VENDOR_RUNTIME_RESET="$CONTROL_ROOT/deploy/scripts/vendor_runtime_reset.py"
VENDOR_CONTROL_RELOAD="$CONTROL_ROOT/deploy/scripts/vendor_control_reload.py"
TEST_UPDATE_MANAGER="$CONTROL_ROOT/deploy/scripts/test_update_manager.py"
TEST_UPDATE_PROMOTE="$CONTROL_ROOT/deploy/scripts/test_update_promote.py"
PUBLIC_CUTOVER_BOOTSTRAP="$CONTROL_ROOT/deploy/scripts/public_cutover_bootstrap.py"
PUBLIC_BASELINE_MANAGER=""
STORAGE_PREFLIGHT="$CONTROL_ROOT/deploy/scripts/storage_preflight.py"
VOLUME_CONTRACT_PREFLIGHT="$CONTROL_ROOT/deploy/scripts/volume_contract_preflight.py"
REDIS_TLS_PREFLIGHT="$CONTROL_ROOT/deploy/scripts/redis_tls_preflight.py"
REDIS_TLS_ROTATION_GUARD="$CONTROL_ROOT/deploy/scripts/redis_tls_rotation_guard.py"
HOST_CONTROL_ROOT="/usr/local/libexec/sms-platform/test-secure-access"
TEST_SECURE_ACCESS_MANAGER="$HOST_CONTROL_ROOT/test_secure_access_manager.py"
CLOUDFLARE_TUNNEL_MANAGER="$HOST_CONTROL_ROOT/cloudflare_tunnel_manager.py"
HOST_BOOTSTRAP=0
if [[ "$WRAPPER_PATH" == "$HOST_CONTROL_ROOT/sms-compose-bootstrap" ]]; then
  HOST_BOOTSTRAP=1
  LOCK_RUNNER="$HOST_CONTROL_ROOT/run_with_lifecycle_lock.py"
  TEST_UPDATE_MANAGER="$HOST_CONTROL_ROOT/test_update_manager.py"
  TEST_UPDATE_PROMOTE="$HOST_CONTROL_ROOT/test_update_promote.py"
  PUBLIC_CUTOVER_BOOTSTRAP="$HOST_CONTROL_ROOT/public_cutover_bootstrap.py"
  PUBLIC_BASELINE_MANAGER="$HOST_CONTROL_ROOT/public_baseline_manager.py"
fi
LOCK_PYTHON=(python3)
if [[ "$HOST_BOOTSTRAP" == 1 ]]; then
  LOCK_PYTHON=(
    /usr/bin/env
    PYTHONNOUSERSITE=1
    "PYTHONPATH=$HOST_CONTROL_ROOT"
    /usr/bin/python3
  )
fi
if [[ "${SMS_SECURE_ACCESS_MANAGER_SMOKE:-0}" == 1 &&
      "$SECRETS_MODE" == development && "$ROOT" != /opt/sms-platform ]]; then
  TEST_SECURE_ACCESS_MANAGER="$CONTROL_ROOT/deploy/scripts/test_secure_access_manager.py"
fi
if [[ "${SMS_CLOUDFLARE_TUNNEL_MANAGER_SMOKE:-0}" == 1 &&
      "$SECRETS_MODE" == development && "$ROOT" != /opt/sms-platform ]]; then
  CLOUDFLARE_TUNNEL_MANAGER="$CONTROL_ROOT/deploy/scripts/cloudflare_tunnel_manager.py"
fi
DEFAULT_RELEASE_ROOT="/var/lib/sms-platform/releases"
RELEASE_ROOT="$DEFAULT_RELEASE_ROOT"
VENDOR_TEST_MARKER="/etc/sms-platform/test-environment"
VENDOR_TEST_STATE_DIR="/var/lib/sms-platform/vendor-test"
VENDOR_CREDENTIAL_ROOT="/var/lib/sms-platform/vendor-test/credentials"
VENDOR_CONTROL_SOCKET_DIR="/run/sms-platform/vendor-control"
TEST_UPDATE_STATE_ROOT="/var/lib/sms-platform/test-updates"
TEST_UPDATE_REQUEST="$TEST_UPDATE_STATE_ROOT/incoming/request.json"
PUBLIC_BASELINE_MANIFEST="$TEST_UPDATE_STATE_ROOT/incoming/baseline-manifest.json"
PUBLIC_BASELINE_ROOT="/opt/sms-platform"
PUBLIC_BASELINE_RUNTIME_ROOT="/run/sms-platform/secrets"
BASE_COMPOSE_FILE="$CONTROL_ROOT/deploy/docker-compose.yml"
PRODUCTION_STORAGE_COMPOSE_FILE="$CONTROL_ROOT/deploy/docker-compose.production-storage.yml"
PRODUCTION_RESTART_COMPOSE_FILE="$CONTROL_ROOT/deploy/docker-compose.production-restart.yml"
REDIS_TLS_COMPOSE_FILE="$CONTROL_ROOT/deploy/docker-compose.redis-tls.yml"
PLATFORM_ENV_FILE="$ROOT/.env"
SOURCE_SECRETS_ROOT="$ROOT/deploy/secrets"
if [[ "$SECRETS_MODE" == production && "$PRODUCTION_CONTROL_SNAPSHOT" == 1 &&
      "$PRODUCTION_CONTROL_SMOKE" != 1 ]]; then
  PLATFORM_ENV_FILE="/etc/sms-platform/platform.env"
  SOURCE_SECRETS_ROOT="/etc/sms-platform/secrets"
fi
COMPOSE=(docker compose --env-file "$PLATFORM_ENV_FILE" -f "$BASE_COMPOSE_FILE")
PRODUCTION_REDIS_HA_MODE=""
EXPECTED_PRODUCTION_METRICS_ALLOWED_CIDRS="172.31.250.1/32"
PRODUCTION_SECURITY_REPORT_ROOT="/var/lib/sms-platform/security-report"
PRODUCTION_SECURITY_REPORT_CONTROL_DIR="$PRODUCTION_SECURITY_REPORT_ROOT/control"
PRODUCTION_SECURITY_REPORT_CONFIG_DIR="$PRODUCTION_SECURITY_REPORT_ROOT/config"
PRODUCTION_SECURITY_REPORT_NGINX_DIR="$PRODUCTION_SECURITY_REPORT_ROOT/nginx"
PRODUCTION_SECURITY_REPORT_INCOMING_DIR="$PRODUCTION_SECURITY_REPORT_CONTROL_DIR/incoming"
PRODUCTION_SECURITY_REPORT_REQUESTS_DIR="$PRODUCTION_SECURITY_REPORT_CONTROL_DIR/requests"
PRODUCTION_SECURITY_REPORT_RESULTS_DIR="$PRODUCTION_SECURITY_REPORT_CONTROL_DIR/results"
ROTATE_WAIT_TIMEOUT=120
BACKEND_SERVICES=(redis redis-auth redis-control api worker-realtime worker-bulk worker-callback outbox-dispatcher beat)
export SMS_RUNTIME_SECRETS_DIR="$RUNTIME_ROOT/current"

CONTROL_PYTHON=(python3)
if [[ "$PRODUCTION_CONTROL_SNAPSHOT" == 1 && "$PRODUCTION_CONTROL_SMOKE" != 1 ]]; then
  CONTROL_PYTHON=(
    /usr/bin/env
    -u PYTHONHOME
    -u PYTHONPATH
    -u PYTHONSTARTUP
    -u PYTHONUSERBASE
    PYTHONNOUSERSITE=1
    /usr/bin/python3
  )
  LOCK_PYTHON=("${CONTROL_PYTHON[@]}")
fi

validate_control_entry() {
  if [[ "$SECRETS_MODE" != production ]]; then
    return 0
  fi
  if [[ "$PRODUCTION_CONTROL_SNAPSHOT" == 1 ]]; then
    if [[ "$PRODUCTION_CONTROL_SMOKE" == 1 ]]; then
      [[ "$ROOT" != /opt/sms-platform ]] || {
        echo "sms-compose: production control smoke mode is forbidden for /opt/sms-platform" >&2
        return 1
      }
    else
      if [[ "$ROOT" != /opt/sms-platform ]]; then
        echo "sms-compose: production project root must be /opt/sms-platform" >&2
        return 1
      fi
      if [[ "${SMS_LIFECYCLE_LOCKED:-}" != 1 ||
            ! "${SMS_LIFECYCLE_LOCK_FD:-}" =~ ^[0-9]+$ ]]; then
        echo "sms-compose: production snapshot must be entered through the stable launcher" >&2
        return 1
      fi
    fi
    return 0
  fi
  if [[ "$PRODUCTION_CONTROL_SMOKE" == 1 && "$ROOT" != /opt/sms-platform &&
        "$CONTROL_ROOT" == "$ROOT" ]]; then
    return 0
  fi
  echo "sms-compose: production actions require the immutable production-control snapshot entry" >&2
  return 1
}

validate_control_state_binding() {
  local action="$1"
  shift
  if [[ "$SECRETS_MODE" != production || "$PRODUCTION_CONTROL_SMOKE" == 1 ]]; then
    return 0
  fi
  if [[ "$action" == host-control ||
        ("$action" == __locked && "${1:-}" == release && "${2:-}" == __host-control) ]]; then
    return 0
  fi
  if ! run_production_control_manager status >/dev/null; then
    echo "sms-compose: production control snapshot state is not verified" >&2
    return 1
  fi
}

configure_internal_compose_env() {
  local line
  if [[ "$INTERNAL_COMPOSE_ENV_WAS_SET" == 1 ]]; then
    echo "sms-compose: shell override of $INTERNAL_COMPOSE_ENV_NAME is forbidden" >&2
    return 1
  fi
  if [[ "$SECRETS_MODE" == production && "$PRODUCTION_CONTROL_SMOKE" != 1 &&
        "$SOURCE_SECRETS_OVERRIDE_WAS_SET" == 1 ]]; then
    echo "sms-compose: shell override of $SOURCE_SECRETS_OVERRIDE_NAME is forbidden" >&2
    return 1
  fi
  if [[ -f "$PLATFORM_ENV_FILE" && ! -L "$PLATFORM_ENV_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^[[:space:]]*SMS_INTERNAL_PLATFORM_ENV_FILE[[:space:]]*= ]]; then
        echo "sms-compose: root .env override of $INTERNAL_COMPOSE_ENV_NAME is forbidden" >&2
        return 1
      fi
      if [[ "$SECRETS_MODE" == production && "$PRODUCTION_CONTROL_SMOKE" != 1 &&
            "$line" =~ ^[[:space:]]*SMS_SOURCE_SECRETS_ROOT[[:space:]]*= ]]; then
        echo "sms-compose: root .env override of $SOURCE_SECRETS_OVERRIDE_NAME is forbidden" >&2
        return 1
      fi
    done < "$PLATFORM_ENV_FILE"
  fi
  export SMS_INTERNAL_PLATFORM_ENV_FILE="$PLATFORM_ENV_FILE"
}

usage() {
  echo "usage: sms-compose up [args...] | down [--remove-orphans] [-v|--volumes (development only)] | rotate backend | run --rm migrate | partition-maintenance [--dry-run] | init-admin --show-temporary-password [--username NAME] [--display-name NAME] | config|ps|logs [development args...]" >&2
  echo "release prepare|bootstrap|start-recovery|observe-recovery|adopt-recovery|resume-recovery|prepare-forward-rollback|activate|status|resume|rollback: use the documented exact arguments" >&2
  echo "production only: continuity engage|release --evidence FILE --evidence-sha256 SHA256; continuity status" >&2
  echo "production host control: host-control plan|prepare|activate --expected-commit COMMIT; host-control status" >&2
  echo "production root units only: host-lifecycle backup|drill|backup-status; security-report" >&2
  echo "development root unit only: vendor-agent-preflight" >&2
  echo "development only: vendor-test bootstrap|activate|pause|resume|rotate|recover-rotation|reset-runtime|reload-agent|status" >&2
  echo "development only: test-update bootstrap-public-cutover|prepare|apply|verify|recover-rebaseline|recover-rebaseline-prepare|status|capability|promote origin/BRANCH COMMIT; cp [args...]" >&2
  echo "host bootstrap only: test-update baseline-prepare|baseline-apply|baseline-verify|baseline-status|baseline-finalize|baseline-cleanup|recover-rebaseline-verify" >&2
  echo "development only: secure-access start|status|stop (test-only HTTPS transport)" >&2
  echo "development only: cloudflare-tunnel install|configure --hostname HOST|install-token|start|status|verify|stop" >&2
  echo "production up options: -d|--detach --remove-orphans --no-deps --force-recreate" >&2
  echo "production up services: postgres redis redis-auth redis-control migrate api worker-realtime worker-bulk worker-callback outbox-dispatcher beat web" >&2
  echo "lifecycle locking: portable Python fcntl runner" >&2
}

configure_release_root() {
  local root_present=0 smoke_present=0
  [[ ${SMS_RELEASE_ROOT+x} ]] && root_present=1
  [[ ${SMS_RELEASE_SMOKE+x} ]] && smoke_present=1

  RELEASE_ROOT="$DEFAULT_RELEASE_ROOT"
  if [[ "$SECRETS_MODE" == production ]]; then
    if [[ "$root_present" == 1 || "$smoke_present" == 1 ]]; then
      echo "sms-compose: production release state override is forbidden" >&2
      return 1
    fi
    return 0
  fi

  if [[ "$root_present" == 0 && "$smoke_present" == 0 ]]; then
    return 0
  fi
  if [[ "$root_present" != 1 || "$smoke_present" != 1 ||
        "${SMS_RELEASE_SMOKE-}" != 1 || -z "${SMS_RELEASE_ROOT-}" ]]; then
    echo "sms-compose: development release state override is invalid" >&2
    return 1
  fi
  RELEASE_ROOT="$SMS_RELEASE_ROOT"
}

trim_non_secret_value() {
  local value="$1"
  value="${value%%#*}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

validate_production_security_report_directory() {
  local path="$1"
  local expected_metadata="$2"
  local metadata
  if [[ ! -d "$path" || -L "$path" || "$(readlink -f -- "$path")" != "$path" ]]; then
    echo "sms-compose: production security-report directory is unsafe: $path" >&2
    return 1
  fi
  metadata="$(stat -c '%u:%g:%a:%F' -- "$path")" || {
    echo "sms-compose: production security-report directory metadata is unavailable: $path" >&2
    return 1
  }
  if [[ "$metadata" != "$expected_metadata" ]]; then
    echo "sms-compose: production security-report directory metadata is unsafe: $path" >&2
    return 1
  fi
}

configure_security_report_paths() {
  if [[ "$SECRETS_MODE" != production || "$PRODUCTION_CONTROL_SMOKE" == 1 ]]; then
    export SMS_SECURITY_REPORT_CONTROL_DIR="$ROOT/deploy/security-report-control"
    export SMS_SECURITY_REPORT_CONFIG_DIR="$ROOT/deploy/security-report-config"
    export SMS_SECURITY_REPORT_NGINX_DIR="$ROOT/deploy/security-report-nginx"
    return 0
  fi

  local parent_metadata
  if [[ ! -d "$PRODUCTION_SECURITY_REPORT_ROOT" ||
        -L "$PRODUCTION_SECURITY_REPORT_ROOT" ||
        "$(readlink -f -- "$PRODUCTION_SECURITY_REPORT_ROOT")" != "$PRODUCTION_SECURITY_REPORT_ROOT" ]]; then
    echo "sms-compose: production security-report state root is unsafe" >&2
    return 1
  fi
  parent_metadata="$(stat -c '%u:%g:%a:%F' -- "$PRODUCTION_SECURITY_REPORT_ROOT")" || {
    echo "sms-compose: production security-report state root metadata is unavailable" >&2
    return 1
  }
  if [[ "$parent_metadata" != "0:0:755:directory" ]]; then
    echo "sms-compose: production security-report state root metadata is unsafe" >&2
    return 1
  fi
  validate_production_security_report_directory \
    "$PRODUCTION_SECURITY_REPORT_CONTROL_DIR" "0:0:755:directory" || return $?
  validate_production_security_report_directory \
    "$PRODUCTION_SECURITY_REPORT_INCOMING_DIR" "0:10001:750:directory" || return $?
  validate_production_security_report_directory \
    "$PRODUCTION_SECURITY_REPORT_REQUESTS_DIR" "10001:10001:700:directory" || return $?
  validate_production_security_report_directory \
    "$PRODUCTION_SECURITY_REPORT_RESULTS_DIR" "10001:10001:700:directory" || return $?
  validate_production_security_report_directory \
    "$PRODUCTION_SECURITY_REPORT_CONFIG_DIR" "10001:10001:700:directory" || return $?
  validate_production_security_report_directory \
    "$PRODUCTION_SECURITY_REPORT_NGINX_DIR" "101:101:750:directory" || return $?

  export SMS_SECURITY_REPORT_CONTROL_DIR="$PRODUCTION_SECURITY_REPORT_CONTROL_DIR"
  export SMS_SECURITY_REPORT_CONFIG_DIR="$PRODUCTION_SECURITY_REPORT_CONFIG_DIR"
  export SMS_SECURITY_REPORT_NGINX_DIR="$PRODUCTION_SECURITY_REPORT_NGINX_DIR"
}

configure_compose_topology() {
  COMPOSE=(docker compose --env-file "$PLATFORM_ENV_FILE" -f "$BASE_COMPOSE_FILE")
  PRODUCTION_REDIS_HA_MODE=""
  if [[ "$SECRETS_MODE" != production ]]; then
    return 0
  fi

  local env_file="$PLATFORM_ENV_FILE"
  local line value
  local seen_redis_ha_mode=0 seen_metrics_allowed_cidrs=0
  if [[ ! -f "$env_file" || -L "$env_file" ||
        "$(readlink -f -- "$env_file")" != "$env_file" ]]; then
    echo "sms-compose: production requires a regular platform environment file" >&2
    return 1
  fi
  if [[ "$PRODUCTION_CONTROL_SMOKE" != 1 ]]; then
    local env_parent="${env_file%/*}"
    local parent_metadata parent_uid parent_gid parent_mode parent_type
    if [[ ! -d "$env_parent" || -L "$env_parent" ||
          "$(readlink -f -- "$env_parent")" != "$env_parent" ]]; then
      echo "sms-compose: production platform environment parent is unsafe" >&2
      return 1
    fi
    parent_metadata="$(stat -c '%u:%g:%a:%F' -- "$env_parent")" || {
      echo "sms-compose: production platform environment parent metadata is unavailable" >&2
      return 1
    }
    IFS=: read -r parent_uid parent_gid parent_mode parent_type <<< "$parent_metadata"
    if [[ "$parent_uid" != 0 || "$parent_gid" != 0 ||
          "$parent_type" != directory || ! "$parent_mode" =~ ^[0-7]{3}$ ||
          $((8#$parent_mode & 8#022)) -ne 0 ]]; then
      echo "sms-compose: production platform environment parent is unsafe" >&2
      return 1
    fi
  fi
  local env_metadata
  env_metadata="$(stat -c '%u:%g:%a:%F' -- "$env_file")" || {
    echo "sms-compose: production platform environment metadata is unavailable" >&2
    return 1
  }
  if [[ "$env_metadata" != "0:0:600:regular file" ]]; then
    echo "sms-compose: production platform environment must be root:root mode 0600" >&2
    return 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*(COMPOSE_FILE|COMPOSE_PROJECT_NAME|SMS_SECURITY_REPORT_CONTROL_DIR|SMS_SECURITY_REPORT_CONFIG_DIR|SMS_SECURITY_REPORT_NGINX_DIR)[[:space:]]*= ]]; then
      echo "sms-compose: production Compose topology overrides are forbidden" >&2
      return 1
    fi
    if [[ "$line" =~ ^[[:space:]]*REDIS_HA_MODE[[:space:]]*=(.*)$ ]]; then
      [[ "$seen_redis_ha_mode" == 0 ]] || {
        echo "sms-compose: duplicate production REDIS_HA_MODE in root .env" >&2
        return 1
      }
      seen_redis_ha_mode=1
      value="${BASH_REMATCH[1]}"
      if [[ "$line" != "REDIS_HA_MODE=$value" ||
            "$value" != isolated-standalone ]]; then
        echo "sms-compose: production REDIS_HA_MODE is invalid" >&2
        return 1
      fi
      PRODUCTION_REDIS_HA_MODE="$value"
    fi
    if [[ "$line" =~ ^[[:space:]]*METRICS_ALLOWED_CIDRS[[:space:]]*=(.*)$ ]]; then
      [[ "$seen_metrics_allowed_cidrs" == 0 ]] || {
        echo "sms-compose: duplicate production METRICS_ALLOWED_CIDRS in root .env" >&2
        return 1
      }
      seen_metrics_allowed_cidrs=1
      value="${BASH_REMATCH[1]}"
      if [[ "$line" != "METRICS_ALLOWED_CIDRS=$EXPECTED_PRODUCTION_METRICS_ALLOWED_CIDRS" ||
            "$value" != "$EXPECTED_PRODUCTION_METRICS_ALLOWED_CIDRS" ]]; then
        echo "sms-compose: production METRICS_ALLOWED_CIDRS is invalid" >&2
        return 1
      fi
    fi
  done < "$env_file"

  if [[ "$seen_redis_ha_mode" != 1 ]]; then
    echo "sms-compose: production requires exactly one REDIS_HA_MODE" >&2
    return 1
  fi
  if [[ "$seen_metrics_allowed_cidrs" != 1 ]]; then
    echo "sms-compose: production requires exactly one METRICS_ALLOWED_CIDRS" >&2
    return 1
  fi
  for value in REDIS_HA_MODE COMPOSE_FILE COMPOSE_PROJECT_NAME; do
    if [[ ${!value+x} ]]; then
      echo "sms-compose: shell Compose topology overrides are forbidden in production" >&2
      return 1
    fi
  done
  for value in SMS_API_IMAGE SMS_WEB_IMAGE SMS_POSTGRES_IMAGE SMS_REDIS_IMAGE; do
    if [[ ${!value+x} ]]; then
      echo "sms-compose: shell image overrides are forbidden in production" >&2
      return 1
    fi
  done
  if [[ ${METRICS_ALLOWED_CIDRS+x} ]]; then
    echo "sms-compose: shell METRICS_ALLOWED_CIDRS override is forbidden in production" >&2
    return 1
  fi
  if [[ "$SECURITY_REPORT_PATH_OVERRIDE_WAS_SET" == 1 ]]; then
    echo "sms-compose: shell security-report path overrides are forbidden in production" >&2
    return 1
  fi

  configure_security_report_paths || return $?

  COMPOSE+=( -f "$PRODUCTION_STORAGE_COMPOSE_FILE" )
  COMPOSE+=( -f "$PRODUCTION_RESTART_COMPOSE_FILE" )
  COMPOSE+=( -f "$REDIS_TLS_COMPOSE_FILE" )
}

run_production_infrastructure_preflights() {
  local storage_mode="${1:-startup}"
  case "$storage_mode" in
    release | startup) ;;
    *)
      echo "sms-compose: invalid production storage preflight mode" >&2
      return 2
      ;;
  esac
  if ! "${CONTROL_PYTHON[@]}" "$STORAGE_PREFLIGHT" --mode "$storage_mode"; then
    echo "sms-compose: production storage preflight failed" >&2
    return 1
  fi
  if [[ "$PRODUCTION_REDIS_HA_MODE" == isolated-standalone ]] &&
     ! "${CONTROL_PYTHON[@]}" "$REDIS_TLS_PREFLIGHT" \
       --secrets-dir "$SOURCE_SECRETS_ROOT"; then
    echo "sms-compose: isolated Redis TLS preflight failed" >&2
    return 1
  fi
  if ! "${CONTROL_PYTHON[@]}" "$VOLUME_CONTRACT_PREFLIGHT"; then
    echo "sms-compose: production volume contract preflight failed" >&2
    return 1
  fi
}

load_development_web_transport() {
  local env_file="$PLATFORM_ENV_FILE"
  local line key raw value
  local seen_external_tls_mode=0 seen_trusted_proxy_cidrs=0
  local seen_trusted_proxy_conf=0
  local env_external_tls_mode='' env_trusted_proxy_cidrs=''
  local env_trusted_proxy_conf='/usr/local/share/sms-platform/trusted-proxies.conf'

  if [[ ! -f "$env_file" || -L "$env_file" ]]; then
    echo "sms-compose: development requires a regular root .env file" >&2
    return 1
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*(SMS_EXTERNAL_TLS_MODE|SMS_TRUSTED_PROXY_CIDRS|SMS_TRUSTED_PROXY_CONF)[[:space:]]*=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      raw="${BASH_REMATCH[2]}"
      value="$(trim_non_secret_value "$raw")"
      case "$key" in
        SMS_EXTERNAL_TLS_MODE)
          [[ "$seen_external_tls_mode" == 0 ]] || {
            echo "sms-compose: duplicate development Web transport setting in root .env" >&2
            return 1
          }
          seen_external_tls_mode=1
          env_external_tls_mode="$value"
          ;;
        SMS_TRUSTED_PROXY_CIDRS)
          [[ "$seen_trusted_proxy_cidrs" == 0 ]] || {
            echo "sms-compose: duplicate development Web transport setting in root .env" >&2
            return 1
          }
          seen_trusted_proxy_cidrs=1
          env_trusted_proxy_cidrs="$value"
          ;;
        SMS_TRUSTED_PROXY_CONF)
          [[ "$seen_trusted_proxy_conf" == 0 ]] || {
            echo "sms-compose: duplicate development Web transport setting in root .env" >&2
            return 1
          }
          seen_trusted_proxy_conf=1
          env_trusted_proxy_conf="$value"
          ;;
      esac
    fi
  done < "$env_file"

  if [[ "$seen_external_tls_mode" != 1 && ! ${SMS_EXTERNAL_TLS_MODE+x} ]]; then
    echo "sms-compose: development requires explicit SMS_EXTERNAL_TLS_MODE" >&2
    return 1
  fi
  DEVELOPMENT_EXTERNAL_TLS_MODE="${SMS_EXTERNAL_TLS_MODE-$env_external_tls_mode}"
  DEVELOPMENT_TRUSTED_PROXY_CIDRS="${SMS_TRUSTED_PROXY_CIDRS-$env_trusted_proxy_cidrs}"
  DEVELOPMENT_TRUSTED_PROXY_CONF="${SMS_TRUSTED_PROXY_CONF-$env_trusted_proxy_conf}"
}

validate_production_launch() {
  local storage_mode="${1:-startup}"
  local env_file="$PLATFORM_ENV_FILE"
  local line key raw value shell_value
  local seen_environment=0 seen_debug=0 seen_auth_mock=0 seen_vendor_mock=0
  local seen_compose_profiles=0 seen_web_bind_ip=0 seen_external_tls_mode=0
  local seen_trusted_proxy_cidrs=0
  local env_environment='' env_debug='' env_auth_mock='' env_vendor_mock=''
  local env_compose_profiles='' env_web_bind_ip='127.0.0.1'
  local env_external_tls_mode='0' env_trusted_proxy_cidrs=''
  local effective_web_bind_ip effective_external_tls_mode effective_trusted_proxy_cidrs

  configure_compose_topology || return $?

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*(SMS_INGRESS_SUBNET|SMS_API_INGRESS_IPV4|SMS_WEB_INGRESS_IPV4)[[:space:]]*= ]]; then
      echo "sms-compose: production ingress overrides are forbidden" >&2
      return 1
    fi
    if [[ "$line" =~ ^[[:space:]]*(ENVIRONMENT|DEBUG|AUTH_MOCK|VENDOR_MOCK|COMPOSE_PROFILES|WEB_BIND_IP|SMS_EXTERNAL_TLS_MODE|SMS_TRUSTED_PROXY_CIDRS)[[:space:]]*=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      raw="${BASH_REMATCH[2]}"
      value="$(trim_non_secret_value "$raw")"
      case "$key" in
        ENVIRONMENT)
          [[ "$seen_environment" == 0 ]] || {
            echo "sms-compose: duplicate production safety setting in root .env" >&2
            return 1
          }
          seen_environment=1
          env_environment="$value"
          ;;
        DEBUG)
          [[ "$seen_debug" == 0 ]] || {
            echo "sms-compose: duplicate production safety setting in root .env" >&2
            return 1
          }
          seen_debug=1
          env_debug="$value"
          ;;
        AUTH_MOCK)
          [[ "$seen_auth_mock" == 0 ]] || {
            echo "sms-compose: duplicate production safety setting in root .env" >&2
            return 1
          }
          seen_auth_mock=1
          env_auth_mock="$value"
          ;;
        VENDOR_MOCK)
          [[ "$seen_vendor_mock" == 0 ]] || {
            echo "sms-compose: duplicate production safety setting in root .env" >&2
            return 1
          }
          seen_vendor_mock=1
          env_vendor_mock="$value"
          ;;
        COMPOSE_PROFILES)
          [[ "$seen_compose_profiles" == 0 ]] || {
            echo "sms-compose: duplicate production safety setting in root .env" >&2
            return 1
          }
          seen_compose_profiles=1
          env_compose_profiles="$value"
          ;;
        WEB_BIND_IP)
          [[ "$seen_web_bind_ip" == 0 ]] || {
            echo "sms-compose: duplicate production Web transport setting in root .env" >&2
            return 1
          }
          seen_web_bind_ip=1
          env_web_bind_ip="$value"
          ;;
        SMS_EXTERNAL_TLS_MODE)
          [[ "$seen_external_tls_mode" == 0 ]] || {
            echo "sms-compose: duplicate production Web transport setting in root .env" >&2
            return 1
          }
          seen_external_tls_mode=1
          env_external_tls_mode="$value"
          ;;
        SMS_TRUSTED_PROXY_CIDRS)
          [[ "$seen_trusted_proxy_cidrs" == 0 ]] || {
            echo "sms-compose: duplicate production Web transport setting in root .env" >&2
            return 1
          }
          seen_trusted_proxy_cidrs=1
          env_trusted_proxy_cidrs="$value"
          ;;
      esac
    fi
  done < "$env_file"

  if [[ "$seen_environment" != 1 || "$env_environment" != production ||
        "$seen_debug" != 1 || "$env_debug" != 0 ||
        "$seen_auth_mock" != 1 || "$env_auth_mock" != 0 ||
        "$seen_vendor_mock" != 1 || "$env_vendor_mock" != 0 ]]; then
    echo "sms-compose: production requires ENVIRONMENT=production with debug and mocks disabled" >&2
    return 1
  fi

  for key in ENVIRONMENT DEBUG AUTH_MOCK VENDOR_MOCK; do
    shell_value="${!key-__SMS_SETTING_UNSET__}"
    if [[ "$shell_value" != __SMS_SETTING_UNSET__ ]]; then
      if [[ "$key" == ENVIRONMENT && "$shell_value" != production ]] ||
         [[ "$key" != ENVIRONMENT && "$shell_value" != 0 ]]; then
        echo "sms-compose: shell overrides must preserve production environment and safety flags" >&2
        return 1
      fi
    fi
  done

  for key in SMS_INGRESS_SUBNET SMS_API_INGRESS_IPV4 SMS_WEB_INGRESS_IPV4; do
    if [[ ${!key+x} ]]; then
      echo "sms-compose: production ingress overrides are forbidden" >&2
      return 1
    fi
  done

  if [[ -n "$env_compose_profiles" ]]; then
    echo "sms-compose: Compose profiles are forbidden in production" >&2
    return 1
  fi
  if [[ -n "${COMPOSE_PROFILES-}" ]]; then
    echo "sms-compose: shell COMPOSE_PROFILES is forbidden in production" >&2
    return 1
  fi

  effective_web_bind_ip="${WEB_BIND_IP-$env_web_bind_ip}"
  effective_external_tls_mode="${SMS_EXTERNAL_TLS_MODE-$env_external_tls_mode}"
  effective_trusted_proxy_cidrs="${SMS_TRUSTED_PROXY_CIDRS-$env_trusted_proxy_cidrs}"
  if ! "${CONTROL_PYTHON[@]}" "$CONTROL_ROOT/scripts/verify_web_transport.py" \
    --validate-bind-only \
    --web-bind-ip "$effective_web_bind_ip" \
    --external-tls-mode "$effective_external_tls_mode" \
    --quiet; then
    echo "sms-compose: production Web plaintext bind is unsafe" >&2
    return 1
  fi
  if ! "${CONTROL_PYTHON[@]}" "$CONTROL_ROOT/deploy/scripts/render_trusted_proxy_conf.py" \
    --mode "$effective_external_tls_mode" \
    --cidrs "$effective_trusted_proxy_cidrs" \
    --validate-only; then
    echo "sms-compose: production TLS terminator allowlist is unsafe" >&2
    return 1
  fi
  PRODUCTION_EXTERNAL_TLS_MODE="$effective_external_tls_mode"
  PRODUCTION_TRUSTED_PROXY_CIDRS="$effective_trusted_proxy_cidrs"
  run_continuity_manager gate >/dev/null || {
    echo "sms-compose: production continuity fence blocks this operation" >&2
    return 1
  }
  if [[ "$storage_mode" == startup ]]; then
    run_release_manager start-gate || {
      echo "sms-compose: production release start gate failed" >&2
      return 1
    }
  fi
  run_production_infrastructure_preflights "$storage_mode"
}

validate_down_args() {
  local argument
  for argument in "$@"; do
    case "$argument" in
      --remove-orphans) ;;
      -v | --volumes)
        if [[ "$SECRETS_MODE" == production ]]; then
          echo "sms-compose: production down must retain persistent volumes" >&2
          return 2
        fi
        ;;
      *)
        echo "sms-compose: unsupported down argument" >&2
        return 2
        ;;
    esac
  done
}

validate_production_up_args() {
  local argument
  for argument in "$@"; do
    case "$argument" in
      -d | --detach | --remove-orphans | --no-deps | --force-recreate) ;;
      postgres | redis | redis-auth | redis-control | migrate | api | worker-realtime | worker-bulk | worker-callback | outbox-dispatcher | beat | web) ;;
      *)
        echo "sms-compose: unsupported production up argument" >&2
        return 2
        ;;
    esac
  done
}

runtime_generation_root_is_empty() (
  local generation_root="$RUNTIME_ROOT/generations"
  local entries
  if [[ ! -e "$generation_root" && ! -L "$generation_root" ]]; then
    return 0
  fi
  if [[ ! -d "$generation_root" || -L "$generation_root" ||
        ! -r "$generation_root" || ! -x "$generation_root" ]]; then
    return 1
  fi
  shopt -s nullglob dotglob
  entries=("$generation_root"/*)
  ((${#entries[@]} == 0))
)

prepare_runtime_secrets() {
  local command baseline_target='' guard_status=0
  if [[ "$SECRETS_MODE" == production ]]; then
    if [[ -e "$RUNTIME_ROOT/current" || -L "$RUNTIME_ROOT/current" ]]; then
      baseline_target="$(current_runtime_target)" || {
        echo "sms-compose: production runtime baseline is invalid" >&2
        return 1
      }
      if [[ ! "$baseline_target" =~ ^generations/generation-[0-9a-f]{32}$ ]]; then
        echo "sms-compose: production runtime baseline is invalid" >&2
        return 1
      fi
    elif ! runtime_generation_root_is_empty; then
      echo "sms-compose: production runtime has generations without a valid current pointer" >&2
      return 1
    fi
  fi
  if [[ "$SECRETS_MODE" == development && ! -f "$VENDOR_CREDENTIAL_ROOT/active" ]]; then
    command=(
      "${CONTROL_PYTHON[@]}" "$PREPROCESSOR" revoke-vendor
      --source-dir "$SOURCE_SECRETS_ROOT"
      --runtime-root "$RUNTIME_ROOT"
      --mode development
    )
  else
    command=(
      "${CONTROL_PYTHON[@]}" "$PREPROCESSOR" prepare
      --source-dir "$SOURCE_SECRETS_ROOT"
      --runtime-root "$RUNTIME_ROOT"
      --mode "$SECRETS_MODE"
    )
    if [[ "$SECRETS_MODE" == development ]]; then
      command+=(--vendor-credential-root "$VENDOR_CREDENTIAL_ROOT")
    fi
  fi
  "${command[@]}" || return $?
  if [[ "$SECRETS_MODE" == production && -n "$baseline_target" ]]; then
    "${CONTROL_PYTHON[@]}" "$REDIS_TLS_ROTATION_GUARD" \
      --source-dir "$SOURCE_SECRETS_ROOT" \
      --runtime-root "$RUNTIME_ROOT" \
      --baseline-target "$baseline_target" || guard_status=$?
    if ((guard_status != 0)); then
      if ! activate_runtime_target "$baseline_target"; then
        echo "sms-compose: Redis TLS guard failed and the previous generation could not be reactivated" >&2
        return 1
      fi
      echo "sms-compose: Redis TLS guard rejected the prepared generation; previous generation reactivated" >&2
      return "$guard_status"
    fi
  fi
}

cleanup_runtime_secrets() {
  "${CONTROL_PYTHON[@]}" "$PREPROCESSOR" cleanup \
    --runtime-root "$RUNTIME_ROOT" \
    --all
}

current_runtime_target() {
  "${CONTROL_PYTHON[@]}" "$PREPROCESSOR" current-target \
    --runtime-root "$RUNTIME_ROOT"
}

activate_runtime_target() {
  "${CONTROL_PYTHON[@]}" "$PREPROCESSOR" activate \
    --runtime-root "$RUNTIME_ROOT" \
    --target "$1"
}

recreate_backend_services() {
  local build_guard=()
  if [[ "$SECRETS_MODE" == production ]]; then
    build_guard=(--no-build)
  fi
  "${COMPOSE[@]}" up -d "${build_guard[@]}" --no-deps --force-recreate \
    --wait --wait-timeout "$ROTATE_WAIT_TIMEOUT" \
    "${BACKEND_SERVICES[@]}"
}

recover_backend_rotation() {
  local old_target="$1"
  if ! activate_runtime_target "$old_target"; then
    echo "sms-compose: recovery failed while reactivating the previous generation" >&2
    return 1
  fi
  if ! recreate_backend_services; then
    echo "sms-compose: recovery failed while restoring backend services" >&2
    return 1
  fi
}

rotate_backend() {
  local old_target rotate_status
  old_target="$(current_runtime_target)"
  if [[ ! "$old_target" =~ ^generations/generation-[0-9a-f]{32}$ ]]; then
    echo "sms-compose: current generation metadata is invalid" >&2
    return 1
  fi
  prepare_runtime_secrets
  if "${COMPOSE[@]}" config --quiet; then
    :
  else
    rotate_status=$?
    recover_backend_rotation "$old_target" || true
    return "$rotate_status"
  fi
  if recreate_backend_services; then
    return 0
  else
    rotate_status=$?
  fi
  recover_backend_rotation "$old_target" || true
  return "$rotate_status"
}

start_stack() {
  local external_tls_mode trusted_proxy_cidrs trusted_proxy_conf
  local build_guard=()
  if [[ "$SECRETS_MODE" == production ]]; then
    build_guard=(--no-build)
    external_tls_mode="$PRODUCTION_EXTERNAL_TLS_MODE"
    trusted_proxy_cidrs="$PRODUCTION_TRUSTED_PROXY_CIDRS"
    trusted_proxy_conf="${SMS_TRUSTED_PROXY_CONF:-/usr/local/share/sms-platform/trusted-proxies.conf}"
  else
    load_development_web_transport || return $?
    external_tls_mode="$DEVELOPMENT_EXTERNAL_TLS_MODE"
    trusted_proxy_cidrs="$DEVELOPMENT_TRUSTED_PROXY_CIDRS"
    trusted_proxy_conf="$DEVELOPMENT_TRUSTED_PROXY_CONF"
  fi
  prepare_runtime_secrets
  "${CONTROL_PYTHON[@]}" "$CONTROL_ROOT/deploy/scripts/render_trusted_proxy_conf.py" \
    --mode "$external_tls_mode" \
    --cidrs "$trusted_proxy_cidrs" \
    --output "$trusted_proxy_conf"
  "${COMPOSE[@]}" config --quiet
  "${COMPOSE[@]}" up "${build_guard[@]}" "$@"
}

stop_stack() {
  local remaining_containers
  "${COMPOSE[@]}" down "$@"
  remaining_containers="$("${COMPOSE[@]}" ps --all -q)"
  if [[ -n "$remaining_containers" ]]; then
    echo "sms-compose: project containers remain after down; runtime secrets retained" >&2
    return 1
  fi
  cleanup_runtime_secrets
}

run_migrate() {
  prepare_runtime_secrets
  "${COMPOSE[@]}" config --quiet
  "${COMPOSE[@]}" run --rm migrate
}

run_partition_maintenance() {
  prepare_runtime_secrets
  "${COMPOSE[@]}" config --quiet
  "${COMPOSE[@]}" run --rm migrate \
    python -m scripts_support.maintain_partitions \
    --max-attempts 3 "$@"
}

INIT_ADMIN_ARGS=()

validate_init_admin_args() {
  local seen_username=0 seen_display_name=0 seen_show=0
  INIT_ADMIN_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --username)
        if [[ "$seen_username" == 1 || $# -lt 2 || -z "$2" || "$2" == -* ]]; then
          echo "sms-compose: invalid init-admin username option" >&2
          return 2
        fi
        seen_username=1
        INIT_ADMIN_ARGS+=("$1" "$2")
        shift 2
        ;;
      --display-name)
        if [[ "$seen_display_name" == 1 || $# -lt 2 || -z "$2" || "$2" == -* ]]; then
          echo "sms-compose: invalid init-admin display-name option" >&2
          return 2
        fi
        seen_display_name=1
        INIT_ADMIN_ARGS+=("$1" "$2")
        shift 2
        ;;
      --show-temporary-password)
        if [[ "$seen_show" == 1 ]]; then
          echo "sms-compose: duplicate init-admin display confirmation" >&2
          return 2
        fi
        seen_show=1
        INIT_ADMIN_ARGS+=("$1")
        shift
        ;;
      *)
        echo "sms-compose: unsupported init-admin argument" >&2
        return 2
        ;;
    esac
  done
  if [[ "$seen_show" != 1 ]]; then
    echo "sms-compose: init-admin requires --show-temporary-password" >&2
    return 2
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "sms-compose: init-admin requires an interactive TTY" >&2
    return 2
  fi
}

run_init_admin() {
  local running_api
  if [[ "$SECRETS_MODE" == production ]]; then
    validate_production_launch
  fi
  prepare_runtime_secrets
  "${COMPOSE[@]}" config --quiet
  running_api="$("${COMPOSE[@]}" ps --status running -q api)"
  if [[ -n "$running_api" ]]; then
    "${COMPOSE[@]}" exec api python -m app.cli init-admin "${INIT_ADMIN_ARGS[@]}"
  else
    "${COMPOSE[@]}" run --rm api python -m app.cli init-admin "${INIT_ADMIN_ARGS[@]}"
  fi
}

validate_release_id() {
  local release_id="$1"
  if [[ ! "$release_id" =~ ^[A-Za-z0-9]([A-Za-z0-9_-]{0,62}[A-Za-z0-9])?$ ||
        "$release_id" == *..* ]]; then
    echo "sms-compose: invalid release id" >&2
    return 2
  fi
}

validate_release_manifest_path() {
  local manifest_path="$1"
  if [[ ! "$manifest_path" =~ ^/[A-Za-z0-9._/-]+/manifest\.json$ ||
        "$manifest_path" == *//* || "$manifest_path" == */../* ||
        "$manifest_path" == */./* ]]; then
    echo "sms-compose: invalid staged manifest path" >&2
    return 2
  fi
}

validate_recovery_evidence_path() {
  local evidence_path="$1"
  if [[ ! "$evidence_path" =~ ^/[A-Za-z0-9._/-]+$ ||
        "$evidence_path" == *//* || "$evidence_path" == */../* ||
        "$evidence_path" == */./* ]]; then
    echo "sms-compose: invalid recovery evidence path" >&2
    return 2
  fi
}

validate_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]] || {
    echo "sms-compose: invalid SHA-256 digest" >&2
    return 2
  }
}

run_release_manager() {
  if [[ "$SECRETS_MODE" == production ]]; then
    "${CONTROL_PYTHON[@]}" "$RELEASE_MANAGER" \
      --platform-root "$ROOT" \
      --control-root "$CONTROL_ROOT" \
      --environment-file "$PLATFORM_ENV_FILE" \
      --release-root "$RELEASE_ROOT" \
      --mode "$SECRETS_MODE" \
      "$@"
  else
    "${CONTROL_PYTHON[@]}" "$RELEASE_MANAGER" \
      --root "$ROOT" \
      --environment-file "$PLATFORM_ENV_FILE" \
      --release-root "$RELEASE_ROOT" \
      --mode "$SECRETS_MODE" \
      "$@"
  fi
}

run_continuity_manager() {
  if [[ "$SECRETS_MODE" == production ]]; then
    "${CONTROL_PYTHON[@]}" "$CONTINUITY_MANAGER" \
      --root "$ROOT" \
      --control-root "$CONTROL_ROOT" \
      --environment-file "$PLATFORM_ENV_FILE" \
      --mode "$SECRETS_MODE" \
      "$@"
  else
    "${CONTROL_PYTHON[@]}" "$CONTINUITY_MANAGER" \
      --root "$ROOT" \
      --environment-file "$PLATFORM_ENV_FILE" \
      --mode "$SECRETS_MODE" \
      "$@"
  fi
}

run_locked_continuity() {
  local lock_fd="$1"
  local subcommand="$2"
  shift 2
  [[ "$SECRETS_MODE" == production ]] || return 2
  case "$subcommand" in
    engage | release)
      [[ $# -eq 4 && "$1" == --evidence && "$3" == --evidence-sha256 ]] || return 2
      validate_recovery_evidence_path "$2" || return $?
      validate_sha256 "$4" || return $?
      configure_compose_topology || return $?
      SMS_LIFECYCLE_LOCKED=1 SMS_LIFECYCLE_LOCK_FD="$lock_fd" \
        run_continuity_manager "$subcommand" "$@"
      ;;
    *)
      return 2
      ;;
  esac
}

dispatch_continuity() {
  local subcommand="${1:-}"
  shift || true
  [[ "$SECRETS_MODE" == production ]] || return 2
  case "$subcommand" in
    status)
      [[ $# -eq 0 ]] || return 2
      run_continuity_manager status
      ;;
    engage | release)
      [[ $# -eq 4 && "$1" == --evidence && "$3" == --evidence-sha256 ]] || return 2
      validate_recovery_evidence_path "$2" || return $?
      validate_sha256 "$4" || return $?
      configure_compose_topology || return $?
      run_with_lifecycle_lock continuity "$subcommand" "$@"
      ;;
    *)
      return 2
      ;;
  esac
}

exec_release_manager() {
  if [[ "$SECRETS_MODE" == production ]]; then
    exec "${CONTROL_PYTHON[@]}" "$RELEASE_MANAGER" \
      --platform-root "$ROOT" \
      --control-root "$CONTROL_ROOT" \
      --environment-file "$PLATFORM_ENV_FILE" \
      --release-root "$RELEASE_ROOT" \
      --mode "$SECRETS_MODE" \
      "$@"
  fi
  exec "${CONTROL_PYTHON[@]}" "$RELEASE_MANAGER" \
    --root "$ROOT" \
    --environment-file "$PLATFORM_ENV_FILE" \
    --release-root "$RELEASE_ROOT" \
    --mode "$SECRETS_MODE" \
    "$@"
}

run_locked_release() {
  local subcommand="$1"
  local prepare_secrets=0
  local runtime_target=''
  shift
  case "$subcommand" in
    prepare)
      [[ $# -eq 2 && "$1" == --manifest ]] || return 2
      validate_release_manifest_path "$2" || return $?
      ;;
    activate | resume | rollback)
      [[ $# -eq 2 && "$1" == --release-id ]] || return 2
      validate_release_id "$2" || return $?
      prepare_secrets=1
      ;;
    bootstrap)
      [[ $# -eq 3 && "$1" == --manifest && "$3" == --confirm-empty-host ]] || return 2
      validate_release_manifest_path "$2" || return $?
      prepare_secrets=1
      ;;
    start-recovery)
      [[ $# -eq 7 && "$1" == --manifest && "$3" == --snapshot-manifest &&
         "$5" == --snapshot-manifest-sha256 && "$7" == --confirm-recovered-host ]] || return 2
      validate_release_manifest_path "$2" || return $?
      validate_recovery_evidence_path "$4" || return $?
      validate_sha256 "$6" || return $?
      prepare_secrets=1
      ;;
    observe-recovery)
      [[ $# -eq 9 && "$1" == --manifest && "$3" == --snapshot-manifest &&
         "$5" == --snapshot-manifest-sha256 && "$7" == --output &&
         "$9" == --confirm-recovered-host ]] || return 2
      validate_release_manifest_path "$2" || return $?
      validate_recovery_evidence_path "$4" || return $?
      validate_sha256 "$6" || return $?
      validate_recovery_evidence_path "$8" || return $?
      ;;
    adopt-recovery)
      [[ $# -eq 15 && "$1" == --manifest && "$3" == --snapshot-manifest &&
         "$5" == --snapshot-manifest-sha256 && "$7" == --restore-receipt &&
         "$9" == --restore-receipt-sha256 && "${11}" == --gap-fence-evidence &&
         "${13}" == --gap-fence-sha256 && "${15}" == --confirm-recovered-host ]] || return 2
      validate_release_manifest_path "$2" || return $?
      validate_recovery_evidence_path "$4" || return $?
      validate_sha256 "$6" || return $?
      validate_recovery_evidence_path "$8" || return $?
      validate_sha256 "${10}" || return $?
      validate_recovery_evidence_path "${12}" || return $?
      validate_sha256 "${14}" || return $?
      ;;
    resume-recovery)
      [[ $# -eq 3 && "$1" == --stage && "$3" == --confirm-recovered-host ]] || return 2
      [[ "$2" =~ ^(api|callback|workers|outbox|beat|web)$ ]] || return 2
      ;;
    prepare-forward-rollback)
      [[ $# -eq 4 && "$1" == --source-release-id && "$3" == --manifest ]] || return 2
      validate_release_id "$2" || return $?
      validate_release_manifest_path "$4" || return $?
      ;;
    *)
      return 2
      ;;
  esac
  if [[ "$SECRETS_MODE" == production ]]; then
    validate_production_launch release || return $?
  fi
  if [[ "$prepare_secrets" == 1 ]]; then
    prepare_runtime_secrets || return $?
  fi
  case "$subcommand" in
    start-recovery | observe-recovery | adopt-recovery | resume-recovery)
      runtime_target="$(current_runtime_target)" || return $?
      if [[ ! "$runtime_target" =~ ^generations/generation-[0-9a-f]{32}$ ]]; then
        echo "sms-compose: recovery runtime secrets target is invalid" >&2
        return 1
      fi
      exec_release_manager "$subcommand" "$@" \
        --runtime-secrets-target "$runtime_target"
      ;;
  esac
  exec_release_manager "$subcommand" "$@"
}

dispatch_release() {
  local subcommand="${1:-}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$subcommand" in
    prepare)
      [[ $# -eq 2 && "$1" == --manifest ]] || return 2
      validate_release_manifest_path "$2" || return $?
      if [[ "$SECRETS_MODE" == production ]]; then
        validate_production_launch release || return $?
        run_with_lifecycle_lock release prepare --manifest "$2"
      else
        run_release_manager prepare --manifest "$2"
      fi
      ;;
    status)
      [[ $# -eq 2 && "$1" == --release-id ]] || return 2
      validate_release_id "$2" || return $?
      run_release_manager status --release-id "$2"
      ;;
    bootstrap)
      [[ $# -eq 3 && "$1" == --manifest && "$3" == --confirm-empty-host ]] || return 2
      validate_release_manifest_path "$2" || return $?
      [[ "$SECRETS_MODE" == production ]] || return 2
      validate_production_launch release || return $?
      run_with_lifecycle_lock release bootstrap --manifest "$2" --confirm-empty-host
      ;;
    start-recovery | observe-recovery | adopt-recovery | resume-recovery)
      [[ "$SECRETS_MODE" == production ]] || return 2
      validate_production_launch release || return $?
      run_with_lifecycle_lock release "$subcommand" "$@"
      ;;
    prepare-forward-rollback)
      [[ $# -eq 4 && "$1" == --source-release-id && "$3" == --manifest ]] || return 2
      validate_release_id "$2" || return $?
      validate_release_manifest_path "$4" || return $?
      [[ "$SECRETS_MODE" == production ]] || return 2
      validate_production_launch release || return $?
      run_with_lifecycle_lock release prepare-forward-rollback \
        --source-release-id "$2" --manifest "$4"
      ;;
    activate | resume | rollback)
      [[ $# -eq 2 && "$1" == --release-id ]] || return 2
      validate_release_id "$2" || return $?
      if [[ "$SECRETS_MODE" == production ]]; then
        validate_production_launch release || return $?
      fi
      run_with_lifecycle_lock release "$subcommand" --release-id "$2"
      ;;
    *)
      return 2
      ;;
  esac
}

run_with_lifecycle_lock() {
  local operation="$1"
  shift
  if [[ "${SMS_LIFECYCLE_LOCKED:-}" == 1 &&
        "${SMS_LIFECYCLE_LOCK_FD:-}" =~ ^[0-9]+$ ]]; then
    run_locked_operation "$operation" "$@"
    return
  fi
  # The child recomputes this wrapper-owned interpolation binding.  Do not
  # propagate it as though it were a caller-supplied override.
  unset SMS_INTERNAL_PLATFORM_ENV_FILE
  unset SMS_SECURITY_REPORT_CONTROL_DIR
  unset SMS_SECURITY_REPORT_CONFIG_DIR
  unset SMS_SECURITY_REPORT_NGINX_DIR
  "${LOCK_PYTHON[@]}" "$LOCK_RUNNER" \
    --runtime-root "$RUNTIME_ROOT" \
    --wrapper "$WRAPPER_PATH" \
    --operation "$operation" \
    -- "$@"
}

reject_production_control_plane() {
  local name="$1"
  if [[ "$SECRETS_MODE" == production ]]; then
    echo "sms-compose: $name is forbidden in production mode" >&2
    return 2
  fi
}

