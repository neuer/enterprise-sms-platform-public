[Unit]
Description=Enterprise SMS Platform vendor test control agent
Requires=docker.service
After=docker.service
Before=sms-platform.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/sms-platform/compose.env
UMask=0007
RuntimeDirectory=sms-platform/vendor-control
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=sms-platform/vendor-test
StateDirectoryMode=0710
ExecStart=/opt/sms-platform/backend/.venv/bin/python /opt/sms-platform/deploy/scripts/vendor_control_agent.py --api-runtime-uid 10001 --api-runtime-gid 10001
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
ReadWritePaths=/opt/sms-platform /etc/sms-platform /var/lib/sms-platform/vendor-test /var/lib/sms-platform/test-backups /run/sms-platform /run/docker.sock
ReadOnlyPaths=-/opt/sms-platform/.dockerignore
ReadOnlyPaths=-/opt/sms-platform/.git
ReadOnlyPaths=-/opt/sms-platform/.github
ReadOnlyPaths=-/opt/sms-platform/.gitignore
ReadOnlyPaths=-/opt/sms-platform/AGENTS.md
ReadOnlyPaths=-/opt/sms-platform/AUTOPILOT.md
ReadOnlyPaths=-/opt/sms-platform/BOOTSTRAP.md
ReadOnlyPaths=-/opt/sms-platform/CLAUDE.md
ReadOnlyPaths=-/opt/sms-platform/HANDOVER.md
ReadOnlyPaths=-/opt/sms-platform/PRD.md
ReadOnlyPaths=-/opt/sms-platform/PROGRESS.md
ReadOnlyPaths=-/opt/sms-platform/RELEASE.md
ReadOnlyPaths=-/opt/sms-platform/TASKS.md
ReadOnlyPaths=-/opt/sms-platform/backend
ReadOnlyPaths=-/opt/sms-platform/deploy
ReadOnlyPaths=-/opt/sms-platform/docs
ReadOnlyPaths=-/opt/sms-platform/frontend
ReadOnlyPaths=-/opt/sms-platform/mise.toml
ReadOnlyPaths=-/opt/sms-platform/openapi.yaml
ReadOnlyPaths=-/opt/sms-platform/pyproject.toml
ReadOnlyPaths=-/opt/sms-platform/schema.sql
ReadOnlyPaths=-/opt/sms-platform/scripts
ReadOnlyPaths=-/etc/sms-platform/compose.env
ReadOnlyPaths=-/etc/sms-platform/production.env
ReadOnlyPaths=-/etc/sms-platform/standby-sync.env
ReadOnlyPaths=-/etc/sms-platform/test-host
ReadOnlyPaths=-/etc/sms-platform/test-update-backup.json
ReadOnlyPaths=-/etc/sms-platform/test-update-backup-key
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
