# deploy/.env.example — 复制为项目根 .env 使用
# 密钥类一律不放这里，全部走 deploy/secrets/ 文件挂载（见 docker-compose.yml secrets 段）
# 生产必须复核: ENVIRONMENT=production、DEBUG=0、AUTH_MOCK=0、VENDOR_MOCK=0；本文件默认值仅供 dev profile。

# ── 数据库 / Redis（密码只走 Docker secrets）──
# 本地构建使用下列默认标签；生产必须替换为受控仓库的 image@sha256:RepoDigest。
SMS_API_IMAGE=sms-platform-api:local
SMS_WEB_IMAGE=sms-platform-web:local
SMS_POSTGRES_IMAGE=sms-platform-postgres:local
SMS_REDIS_IMAGE=sms-platform-redis:local
POSTGRES_DB=sms
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sms
# 数据库用户名和密码文件由 Compose 按服务职责固定，禁止在 .env 覆盖。
# 三个 Redis 故障域必须使用不同端点；密码固定从同名 Docker secret 读取。
REDIS_HA_MODE=standalone
REDIS_BROKER_HOST=redis
REDIS_AUTH_HOST=redis-auth
REDIS_CONTROL_HOST=redis-control
# 每个 OS 进程独立预算；总上限按「进程数 × (pool+overflow)」核算。
# 默认 Compose 上限：API 24（含 metrics）、三个 Celery worker 24、
# beat 启动期 2、Outbox dispatcher 2，共 52；生产须为运维/迁移预留连接。
DB_API_POOL_SIZE=8
DB_API_MAX_OVERFLOW=2
DB_WORKER_POOL_SIZE=3
DB_WORKER_MAX_OVERFLOW=1
DB_BEAT_POOL_SIZE=2
DB_BEAT_MAX_OVERFLOW=0
DB_METRICS_POOL_SIZE=2
DB_METRICS_MAX_OVERFLOW=0
DB_BACKGROUND_POOL_SIZE=2
DB_BACKGROUND_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=3
DB_CONNECT_TIMEOUT_SECONDS=3
DB_API_STATEMENT_TIMEOUT_MS=15000
DB_WORKER_STATEMENT_TIMEOUT_MS=30000
DB_BEAT_STATEMENT_TIMEOUT_MS=10000
DB_METRICS_STATEMENT_TIMEOUT_MS=2000
DB_BACKGROUND_STATEMENT_TIMEOUT_MS=30000
READINESS_TIMEOUT_SECONDS=2
READINESS_QUEUE_TIMEOUT_SECONDS=0.1
READINESS_MAX_CONCURRENCY=2
# 当前月之外至少预建未来三个月；提高窗口会同步提高 readyz 要求。
READINESS_FUTURE_MONTHS=3
# 生产改为独立监控网段的精确 CIDR；公网来源不得加入。
METRICS_ALLOWED_CIDRS=172.16.0.0/12
METRICS_COLLECTION_TIMEOUT_SECONDS=2
METRICS_SNAPSHOT_TTL_SECONDS=15

# ── 厂商网关 ──
# 1=走 mock；生产置 0
VENDOR_MOCK=1
# 生产: https://vendor.example.invalid
VENDOR_BASE_URL=http://mock-vendor:9028
# 真实联调时由本地私有配置设置，并与 VENDOR_BASE_URL 完全一致。
VENDOR_LIVE_TEST_ORIGIN=https://vendor.example.invalid
# 本示例显式启用 dev profile；生产必须改为空值。
COMPOSE_PROFILES=dev
# 部署侧精确允许列表，管理员不可扩大
ALERT_SMTP_ALLOWED_HOSTS=smtp
# vendor secretName/secretKey → deploy/secrets/vendor_secret_name|key

# ── 认证运行边界 ──
# 开发/自动化=1；生产必须=0
AUTH_MOCK=1
LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password
LDAP_CA_CERTS_FILE=/etc/ssl/certs/ca-certificates.crt
# 部署侧 LDAP 目标精确允许列表（host 或 host:port，分号/逗号分隔）；禁止空列表回退
LDAP_ALLOWED_HOSTS=
# AD 服务、DN、过滤器、属性和超时均由管理员登录后在系统配置页维护；不从环境变量读取。

# ── Callback TLS（可选；这里只配置挂载路径，证书/私钥内容不得写入 .env）──
# 私有 CA、mTLS 客户端证书和私钥必须由生产部署以只读受控文件挂载后再取消注释。
# CALLBACK_CA_CERTS_FILE=/run/secrets/callback_ca_certs
# CALLBACK_MTLS_CERT_FILE=/run/secrets/callback_mtls_cert
# CALLBACK_MTLS_KEY_FILE=/run/secrets/callback_mtls_key

# ── 平台 ──
ENVIRONMENT=development
# 生产必须=0；DEBUG=0时AUTH_MOCK=1启动失败
DEBUG=1
TZ=Asia/Shanghai
# TLS 终结配置完成后启用；两者仅供无凭据部署探针使用。
WEB_HTTP_BASE_URL=http://sms.example.com:18080
WEB_BASE_URL=https://sms.example.com:18443
LOG_LEVEL=INFO

# 本地一键环境端口由 scripts/local_test.sh 的 WEB_PORT/API_PORT/MOCK_VENDOR_PORT 控制；
# 默认 18180/18100/19128，不写入容器运行环境，也不影响生产 Compose 默认端口。
